    }
}

' ==========================================
' 7. CONSUMERS DE KAFKA (src/consumers)
' ==========================================

namespace CONSUMERS #ffd4e8{
    class consumerEmails <<emailConsumer.js>>{
        - esperar(milisegundos : int) : void
        - enviarComprobante(idVenta : int) : void
        - manejarVentaCerrada(datos : object) : void
        - iniciarConsumer() : void
    }

    class consumerFeed <<feedConsumer.js>>{
        - manejarInteraccion(datos : object) : void
        - manejarSync(datos : object) : void
        - iniciarConsumer() : void
    }
}

' =========================================
'  RELACIONES
' ==========================================
Ventas -- estadoVenta
cuponesDescuentos -- tipoDescuento
Usuario -- tipoAuth
Productos -- tipoProducto
ArchivoDigital -- tipoArchivo
InteraccionEvento -- tipoEvento
SyncInteresEvento -- accionSync
Usuario -- Ubicaciones
Usuario -- Categoria : intereses
Emprendedor -- Tiendas
Tiendas -- Cliente
Tiendas -- Productos
Productos -- Categoria
Tiendas -- cuponesDescuentos
Tiendas ---- Ventas
Tiendas -- Correo
Cliente -- Ventas
Ventas -- Pagos
Ventas -- cuponesDescuentos
DetalleVenta -- Productos
cuponesDescuentosProductos -- Productos
ProductosDigitales -- licenciaVenta
DetalleVentaDigital -- licenciaVenta
AtributoCategoria -- EspecificacionProducto
' Herencia
' ____________________________________
Usuario <|--- Emprendedor
Usuario <|---- Cliente
Productos <|-- ProductosDigitales
Productos <|-- ProductosFisicos
cuponesDescuentos <|-- cuponesDescuentosProductos
DetalleVenta <|-- DetalleVentaDigital
' Composiciones
' ____________________________________
Ventas *-- DetalleVenta
Categoria *-- AtributoCategoria
Productos *-- EspecificacionProducto
' Dependencias débiles entre models
' ____________________________________
Productos ..> ArchivoDigital
Tiendas ..> ArchivoDigital
InteraccionEvento ..> Productos
SyncProductoEvento ..> Productos
SyncInteresEvento ..> Categoria
ProductoFeed ..> Productos
InteresFeed ..> Categoria
' Dependencias (controlador -> service)
' ____________________________________
controladorUsuarios --> serviceUsuarios
controladorUsuarios --> serviceTiendas
controladorUsuarios --> serviceIntereses
controladorUsuarios --> serviceGoogleMaps
controladorTiendas --> serviceTiendas
controladorTiendas --> serviceEmprendedores
controladorTiendas --> serviceProductos
controladorTiendas --> serviceClientes
controladorTiendas --> serviceAwsS3
controladorEstadisticas --> serviceEstadisticas
controladorProductos --> serviceProductos
controladorProductos --> serviceTiendas
controladorProductos --> serviceAwsS3
controladorCategorias --> serviceCategorias
controladorUbicaciones --> serviceGoogleMaps
controladorCupones --> serviceCuponesDescuentos
controladorVentas --> serviceVentas
controladorVentas --> serviceClientes
controladorMercadoPago --> servicePagos
controladorMercadoPago --> serviceVentas
controladorMercadoPago --> serviceEmprendedores
controladorMercadoPago --> serviceGoogleMaps
controladorMercadoPago --> serviceMercadoPago
controladorEmails --> serviceCorreos
controladorEmails --> serviceUsuarios
controladorEmails --> serviceResend
controladorLicencias --> serviceLicencias
controladorFeed --> serviceFeed
controladorFeed --> serviceProductos
controladorTracking --> serviceKafka
' Dependencias (service -> servicio externo)
' ____________________________________
serviceProductos --> serviceAwsS3
serviceProductos --> serviceKafka
serviceIntereses --> serviceKafka
serviceVentas --> serviceResend
serviceVentas --> serviceKafka
serviceCorreos --> serviceResend
serviceFeed --> serviceMCP
serviceFeedSync --> serviceMCP
serviceMercadoPago --> serviceEmprendedores
' Dependencias (consumer -> service)
' ____________________________________
consumerEmails --> serviceVentas
consumerEmails --> serviceResend
consumerFeed --> serviceMCP
consumerEmails ..> Correo
consumerFeed ..> InteraccionEvento
consumerFeed ..> SyncProductoEvento
consumerFeed ..> SyncInteresEvento
' Agregaciones (service -> model que administra)
' ____________________________________
serviceUsuarios o-- Usuario
serviceClientes o-- Cliente
serviceEmprendedores o-- Emprendedor
serviceTiendas o-- Tiendas
serviceProductos o-- Productos
serviceCategorias o-- Categoria
serviceUbicaciones o-- Ubicaciones
serviceCuponesDescuentos o-- cuponesDescuentos
serviceVentas o-- Ventas
servicePagos o-- Pagos
serviceLicencias o-- licenciaVenta
serviceCorreos o-- Correo

@enduml
