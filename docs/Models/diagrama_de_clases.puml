@startuml
left to right direction
skinparam linetype ortho
skinparam nodesep 100
skinparam ranksep 140
skinparam DefaultFontName "Ubuntu"

' ==========================================
' 1. ENUMERADORES
' ==========================================

package ENUMS <<Frame>> #ffe9d4{
    enum estadoVenta{
        ABIERTA
        CANCELADA
        CERRADA
    }

    enum tipoDescuento{
        MONTOFIJO
        PORCENTAJE
    }

    enum tipoAuth{
        MANUAL
        GOOGLE
    }

    enum tipoProducto{
        FISICO
        DIGITAL
    }

    enum metodoPago{
        QR
        TARJETA
    }

    enum tipoArchivo{
        ARCHIVO
        IMAGEN PRODUCTO
    }

    enum tipoEvento{
        Detalle
        VisitaTienda
        Carrito
        Compra
    }

    enum accionSync{
        agregar
        eliminar
    }
}

' ==========================================
' 2. MODELS (src/models)
' ==========================================

namespace MODELS #ffffd4{
    entity Usuario{
        - email : string
        - psw : string
        - tipoAuth : tipoAuth
        - nombre : string
        - apellido : string
        - telefono : string
        - activo : boolean
        - fechaBaja : date
        - fechaCreacion : date
        + {static} fromRow(row : object) : Usuario
    }

    entity Emprendedor{
        - cuit : string
        - mpAccessToken : string
        - mpRefreshToken : string
        - mpUserId : string
        - mpPublicKey : string
        - mpTokenExpiresAt : date
        - mpQrAccessToken : string
        - mpQrRefreshToken : string
        - mpQrUserId : string
        - mpQrTokenExpiresAt : date
        - mpQrStoreId : string
        - mpQrPosId : string
        + {static} fromRow(row : object) : Emprendedor
    }

    entity Cliente{
        - suscripcion : boolean
        - resendContactID : string
    }

    entity Ubicaciones{
        - direccion : string
        - piso : string
        - depto : string
        - pais : string
        - provincia : string
        - ciudad : string
        - codigo : string
        - placeid : string
        + {static} fromRow(row : object) : Ubicaciones
    }

    entity Tiendas{
        - nombreTienda : string
        - logoTienda : string
        - fechaCreacion : date
        - activo : boolean
        + {static} fromRow(row : object) : Tiendas
    }

    entity Productos{
        - tipoProd : tipoProducto
        - nombreProd : string
        - imagenProd : string
        - descripProd : string
        - precio : number
        - activo : boolean
        + {static} fromRow(row : object) : Productos
    }

    entity ProductosDigitales{
        - archivoProd : string
        - usaLicencia : boolean
    }

    entity ProductosFisicos{
        - stock : int
    }

    entity Categoria{
        - categoria : string
        + {static} fromRow(row : object) : Categoria
    }

    entity AtributoCategoria{
        - nombreAtributo : string
    }

    entity EspecificacionProducto{
        - valor : string
        + {static} fromRow(row : object) : EspecificacionProducto
    }

    entity cuponesDescuentos{
        - codigo : string
        - tipoDescuento : tipoDescuento
        - valor : number
        - fechaExpiracion : date
        - usosMaximos : int
        - usosActuales : int
        - aplicaTienda : boolean
        - vencido : boolean
        + {static} fromRow(row : object) : cuponesDescuentos
    }

    entity cuponesDescuentosProductos

    entity Ventas{
        - fechaVenta : date
        - precioFinal : number
        - estado : estadoVenta
        + {static} fromRow(row : object, items : List<DetalleVenta>) : Ventas
    }

    entity DetalleVenta{
        - precioUnitario : number
        - cantidad : int
        - subtotal : number
        + {static} fromRow(row : object) : DetalleVenta
    }

    entity DetalleVentaDigital

    entity licenciaVenta{
        - claveDigital : string
        - claveUsada : boolean
        + {static} fromRow(row : object) : licenciaVenta
    }

    entity Pagos{
        - idTransaccion : string
        - estado : string
        - metodoPago : string
        - monto : number
    }

    class Correo{
        - from : string
        - to : string | List<string>
        - subject : string
        - html : string
        - text : string
    }

    class ArchivoDigital{
        - originalname : string
        - mimetype : string
        - path : string
        - size : int
        - type : tipoArchivo
        - key : string
        + extension() : string
    }

    class Filtros{
        - busqueda : string
        - idCat : int
        - total : int
        - offset : int
        - desde : date
        - hasta : date
    }
}


' ==========================================
' 3. EVENTOS Y FEED (Kafka y microservicio de recomendaciones)
' ==========================================

namespace EVENTOS #ecdcff{
    class InteraccionEvento{
        - idPersona : int
        - idProducto : int
        - tipoEvento : tipoEvento
    }

    class SyncProductoEvento{
        - tipo : string = "producto"
        - idProducto : int
        - idCat : int
        - idTienda : int
        - activo : boolean
    }

    class SyncInteresEvento{
        - tipo : string = "interes"
        - idPersona : int
        - idCat : int
        - accion : accionSync
    }

    class ProductoFeed{
        - idProducto : int
        - idCat : int
        - idTienda : int
        - activo : boolean
    }

    class InteresFeed{
        - idPersona : int
        - idCat : int
    }
}

' ==========================================
' 4. SERVICES (src/services)
' ==========================================

namespace SERVICES #ddffd4{
    class serviceUsuarios <<usuarioService.js>>{
        + registrarseManualService(user : Usuario, ubicacion : Ubicaciones, categorias : List<Categoria>) : Usuario
        + autenticarUsuarioService(user : Usuario) : Usuario
        + modificarUsuarioService(usuario : Usuario, ubicacion : Ubicaciones, categorias : List<Categoria>) : Usuario
        + cambiarActivoUsuarioService(user : Usuario) : Usuario
        + buscarUsuarioPorEmail(user : Usuario) : Usuario
        + buscarUsuarioPorId(user : Usuario) : Usuario
        + cambiarPswUsuario(user : Usuario) : boolean
    }

    class serviceClientes <<clientesService.js>>{
        + crearClienteService(usuario : Cliente, tienda : Tiendas) : int
        + seguirTiendaService(usuario : Usuario, tienda : Tiendas) : int
        + dejarDeSeguirTiendaService(usuario : Usuario, tienda : Tiendas) : boolean
        + obtenerTiendasSeguidasService(usuario : Usuario) : List<Tiendas>
        + verificarAccesoClienteService(venta : Ventas, usuario : Usuario, tienda : Tiendas) : boolean
    }

    class serviceEmprendedores <<emprendedorService.js>>{
        + crearEmprendedorService(emprendedor : Emprendedor) : int
        + modificarEmprendedorService(emprendedor : Emprendedor) : boolean
        + obtenerEmprendedorPorTienda(emprendedor : Emprendedor) : Emprendedor
        + obtenerEmprendedorPorMpUserId(emprendedor : Emprendedor) : Emprendedor
    }

    class serviceTiendas <<tiendasService.js>>{
        + crearTiendaService(emprendedor : Emprendedor, tienda : Tiendas) : int
        + modificarTiendaService(tienda : Tiendas) : boolean
        + cambiarActivoTiendaService(tienda : Tiendas) : boolean
        + buscarTiendaPorId(tienda : Tiendas) : Tiendas
        + buscarTiendaPorPersona(user : Usuario) : Tiendas
    }

    class serviceProductos <<productosService.js>>{
        + sincronizarProductosTiendaFeed(tienda : Tiendas) : void
        + crearProductoService(producto : Productos, atributos : AtributoCategoria, especificacion : EspecificacionProducto) : int
        + modificarProductoService(producto : Productos, atributos : AtributoCategoria, especificacion : EspecificacionProducto) : boolean
        + cambiarActivoProductosService(productos : List<Productos>) : boolean
        + buscarProductoPorId(producto : Productos) : Productos
        + buscarProductosPorIds(productos : List<Productos>) : List<Productos>
        + obtenerArchivoProductoService(producto : Productos) : ArchivoDigital
        + subirArchivoDigitalS3(archivo : ArchivoDigital) : boolean
        + obtenerURLService(detalle : DetalleVenta, usuario : Usuario) : string
        + obtenerProductosTiendaService(tienda : Tiendas) : List<Productos>
        + buscarProductosService(filtros : Filtros) : List<Productos>
    }

    class serviceCategorias <<categoriasService.js>>{
        + obtenerCategoriasService() : List<Categoria>
        + guardarCategoriaService(atributos : AtributoCategoria, especificacion : EspecificacionProducto) : EspecificacionProducto
    }

    class serviceIntereses <<interesesService.js>>{
        + obtenerInteresesService(usuario : Usuario) : List<Categoria>
        + guardarInteresesService(user : Usuario, categorias : List<Categoria>) : boolean
    }

    class serviceUbicaciones <<ubicacionesService.js>>{
        + guardarUbicacionService(ubicacion : Ubicaciones) : int
        + actualizarUbicacionService(ubicacion : Ubicaciones) : Ubicaciones
        + ubicacionCompartidaService(usuario : Usuario, ubicacion : Ubicaciones) : boolean
        + copiarUbicacionService(ubicacion : Ubicaciones) : int
    }

    class serviceCuponesDescuentos <<cuponesDescuentosService.js>>{
        + crearCuponService(cupon : cuponesDescuentos) : int
        + eliminarCuponService(cupon : cuponesDescuentos) : boolean
        + modificarCuponService(cupon : cuponesDescuentos) : boolean
        + obtenerCuponesTiendaService(cupon : cuponesDescuentos) : List<cuponesDescuentos>
        + buscarCuponPorId(cupon : cuponesDescuentos) : cuponesDescuentos
        + buscarCuponPorCodigo(cupon : cuponesDescuentos) : cuponesDescuentos
    }

    class serviceVentas <<ventasService.js>>{
        + crearVentaService(tienda : Tiendas, cliente : Cliente, items : List<DetalleVenta>, cupon : cuponesDescuentos) : [int, List<Productos>, number, number]
        + finalizarVentaService(venta : Ventas) : int
        + buscarVentaPorId(venta : Ventas) : Ventas
        + obtenerDetalleVentaService(venta : Ventas) : Ventas
        + obtenerVentaParaPagarService(venta : Ventas, usuario : Usuario, metodo : metodoPago) : [Ventas, Emprendedor]
        + obtenerVentasClienteService(venta : Ventas) : List<Ventas>
        + verificarAccesoVentaService(venta : Ventas, usuario : Usuario, tienda : Tiendas) : Ventas
        + obtenerVentasPersonaService(usuario : Usuario) : List<Ventas>
    }

    class servicePagos <<pagosService.js>>{
        + crearPagoService(pago : Pagos) : int
    }

    class serviceLicencias <<licenciaVentaService.js>>{
        + crearLicenciaVentaService(licencia : licenciaVenta) : int
        + validarLicenciaService(licencia : licenciaVenta, user : Usuario) : licenciaVenta
    }

    class serviceCorreos <<emailService.js>>{
        + enviarPromocionTiendaService(correo : Correo) : object
    }

    class serviceEstadisticas <<estadisticasService.js>>{
        + obtenerEstadisticasService(tienda : Tiendas, filtros : Filtros) : object
        + generarCsvEstadisticasService(tienda : Tiendas, filtros : Filtros) : string
    }

    class serviceFeed <<feedService.js>>{
        + obtenerFeedService(usuario : Usuario, filtros : Filtros, tiendaPropia : Tiendas) : List<Productos>
    }

    class serviceFeedSync <<feedSyncService.js>>{
        + iniciarFeed() : void
        + resincronizarFeed() : object
    }
}

' ==========================================
' 5. SERVICIOS EXTERNOS (src/services/api)
' ==========================================

namespace SERVICIOS_EXTERNOS #e9ffd4{
    class serviceMercadoPago <<api/mercadoPagoService.js>>{
        + obtenerUrlConexion(state : string) : string
        + intercambiarCodigoService(code : string) : object
        + obtenerAccessTokenVigente(emprendedor : Emprendedor) : string
        + obtenerUrlConexionQr(state : string) : string
        + intercambiarCodigoQrService(code : string) : object
        + obtenerAccessTokenQrVigente(emprendedor : Emprendedor) : string
        + crearOrdenService(datosVenta : Ventas, emprendedor : Emprendedor, metodo : metodoPago, datosTarjeta : object) : object
        + crearSucursalYCajaService(accessToken : string, mpUserId : string, direccion : Ubicaciones) : object
        + validarFirmaWebhook(xSignature : string, xRequestId : string, dataId : string, secret : string) : object
        + consultarOrdenService(accessToken : string, idOrden : string) : object
    }

    class serviceAwsS3 <<api/awsS3Service.js>>{
        + subirArchivo(archivo : ArchivoDigital) : boolean
        + generarUrlDescarga(archivo : ArchivoDigital) : string
        + generarURLPublica(archivo : ArchivoDigital) : string
    }

    class serviceGoogleMaps <<api/googleMapsService.js>>{
        + obtenerPaisesDisponibles() : List<object>
        + validarDireccion(ubicacion : Ubicaciones) : object
    }

    class serviceResend <<api/resendService.js>>{
        + enviarCorreoIndividual(correo : Correo) : object
        + enviarCorreosMarketing(correo : Correo, contactos : List<Cliente>) : object
    }

    class serviceKafka <<api/kafkaService.js>>{
        + publicarEvento(topic : string, mensaje : object) : void
    }

    class serviceMCP <<api/MCPservice.js>>{
        + verificarEstadoFeed() : string
        + llamarToolMCP(tool : string, parametros : object) : object
        + resyncCompletoFeed(productos : List<ProductoFeed>, intereses : List<InteresFeed>) : void
        + getUserFeedMcp(usuario : Usuario, filtros : Filtros, tiendaPropia : Tiendas) : List<int>
        + registrarInteraccionFeed(evento : InteraccionEvento) : void
        + syncProductoFeed(evento : SyncProductoEvento) : void
        + setInteresesUsuarioFeed(evento : SyncInteresEvento) : void
    }
}

' =========================================
'  6. CONTROLADORES (src/controllers)
' ==========================================

namespace CONTROLLERS #d4fff1{
    class controladorUsuarios <<usuarioController.js>>{
        + registrarseManual() : void
        + registrarseGoogle() : void
        + logggearseManual() : void
        + loggearseGoogle() : void
        + modificarDatosUsuario() : void
        + desactivarCuenta() : void
        + reactivarCuenta() : void
        + codigoRecuperarPsw() : void
        + obtenerPerfil() : void
        + obtenerMisIntereses() : void
    }

    class controladorTiendas <<TiendasController.js>>{
        + crearTienda() : void
        + modificarTienda() : void
        + eliminarTienda() : void
        + reactivarTienda() : void
        + obtenerPublicKey() : void
        + obtenerTiendaPublica() : void
        + obtenerMiTienda() : void
        + seguirTienda() : void
        + dejarDeSeguirTienda() : void
        + obtenerTiendasSeguidas() : void
    }

    class controladorEstadisticas <<estadisticasController.js>>{
